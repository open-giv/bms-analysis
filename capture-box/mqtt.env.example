# Settings for givcap-mqtt. setup.sh copies this to /etc/givcap/mqtt.env (root only).
# Edit the copy on the Pi. Never commit a file with the real password.
# systemd reads this file: a backslash is treated as an escape and surrounding quotes are removed,
# so avoid backslashes in the password, and don't start or end it with a quote or a space.
MQTT_HOST=homeassistant.local
MQTT_PORT=1883
MQTT_USER=givcap
MQTT_PASSWORD=change-me
MQTT_TOPIC_PREFIX=GivEnergy
# Optional: exit (and let systemd restart the logger) after this many seconds with no message.
# GivTCP publishes every few seconds, so 600 only trips when something is broken.
#MQTT_STALL_S=600
